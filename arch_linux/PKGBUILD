# Maintainer: Alex <alexzkhr public at gmail dot com>

pkgname=ed_highway
pkgver=r112.d43b0ae
pkgrel=1
pkgdesc='Desktop client of Neutron star routes plotter for Elite Dangerous. Based on https://www.spansh.co.uk/plotter'
arch=('i686' 'x86_64')
url='https://github.com/alexzk1/ed_highway'
license=('MIT')
depends=(
curl
cereal
)

makedepends=(
git
)
source=(
"git+$url.git"
)
sha256sums=('SKIP')
_gitname='ed_highway'

qt_version="qt6"

check() {
  if [[ "$qt_version" == "qt6" ]]; then
    depends+=('qt6-base')
  else
    depends+=('qt5-base')
  fi
}

prepare() {
  if [[ -n "$QT_VERSION" ]]; then
    qt_version="$QT_VERSION"
  fi
  cd $_gitname
  git submodule init
  git submodule update
}

pkgver() {
  cd $_gitname
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    local qt_base
    if [[ "$qt_version" == "qt6" ]]; then
        qt_base="Qt6"
    else
        qt_base="Qt5"
    fi

    cmake -B build -S "$_gitname" -DBUILD_TESTS=OFF -DCMAKE_BUILD_TYPE=Release -DQT_VERSION_MAJOR="$qt_base"
    cmake --build build
}
package() {
  cd $_gitname
  #make INSTALL_ROOT="$pkgdir" install
  install -Dm755 "$srcdir"/build/ed_highway "$pkgdir"/usr/bin/ed_highway

  install -d $pkgdir/usr/share/applications
  install -m644 $srcdir/ed_highway/arch_linux/ed_highway.desktop "$pkgdir"/usr/share/applications/

  install -d $pkgdir/usr/share/icons/hicolor/128x128/apps/
  install -m644 $srcdir/ed_highway/arch_linux/ed_highway.png "$pkgdir"/usr/share/icons/hicolor/128x128/apps/
}
